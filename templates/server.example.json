      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/REPLACE_WITH_WS_PATH"
        }
      }
    },
    {
      "tag": "node-b",
      "listen": "::",
      "port": 10087,
      "protocol": "vmess",
      "settings": {
        "sspanel": {
          "url": "https://panel.example.invalid",
          "key": "REPLACE_WITH_PANEL_KEY",
          "node_id": "NODE_ID_B",
          "refresh": 60,
          "conn_limit": 0
        }
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/REPLACE_WITH_WS_PATH"
        }
