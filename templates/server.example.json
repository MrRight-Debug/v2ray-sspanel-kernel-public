{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "node-a",
      "listen": "0.0.0.0",
      "port": 10086,
      "protocol": "vmess",
      "settings": {
        "sspanel": {
          "url": "https://panel.example.invalid",
          "key": "REPLACE_WITH_PANEL_KEY",
