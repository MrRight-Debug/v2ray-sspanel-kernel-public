{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "sspanel-dynamic-ipv6",
      "listen": "::1",
      "port": 21004,
      "protocol": "vmess",
      "settings": {
        "sspanel": {
          "url": "http://[::1]:22001",
          "key": "test-key",
          "node_id": "2",
          "refresh": "1",
          "conn_limit": "3"
        }
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/dynamic-v6"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
