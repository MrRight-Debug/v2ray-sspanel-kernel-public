{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "sspanel-dynamic",
      "listen": "127.0.0.1",
      "port": 21003,
      "protocol": "vmess",
      "settings": {
        "sspanel": {
          "url": "http://127.0.0.1:22000",
          "key": "test-key",
          "node_id": 1,
          "refresh": 1,
          "conn_limit": 3
        }
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/dynamic"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
